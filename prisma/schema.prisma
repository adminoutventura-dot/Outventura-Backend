generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Role {
  id_role     Int     @id @default(autoincrement())
  code        String  @unique
  description String?

  users User[]
}

model User {
  id_user          Int     @id @default(autoincrement())
  name             String
  surname          String
  email            String  @unique
  phone            String?
  photo            String?
  password         String
  experience_level String?
  status           Boolean @default(true)

  roleId Int
  role   Role @relation(fields: [roleId], references: [id_role])

  guide Guide?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Guide {
  id_guide    Int    @id @default(autoincrement())
  userId      Int    @unique
  user        User   @relation(fields: [userId], references: [id_user])
  specialty   String
  credentials String

  activities Activity[]
}

model Category {
  id_category Int     @id @default(autoincrement())
  code        String  @unique
  description String?

  equipments Equipment[]
  activities Activity[]
}

model EquipmentStatus {
  id_status   Int     @id @default(autoincrement())
  code        String  @unique
  description String?

  equipments Equipment[]
}

model Equipment {
  id_equipment  Int     @id @default(autoincrement())
  title         String
  description   String?
  price_per_day Decimal @db.Decimal(10, 2)
  units         Int     @default(1)

  statusId Int
  status   EquipmentStatus @relation(fields: [statusId], references: [id_status])

  categories Category[]
}

model Activity {
  id_activity      Int      @id @default(autoincrement())
  title            String
  description      String?
  init_date        DateTime
  end_date         DateTime
  difficulty       Int
  max_participants Int
  start_end_point  String?

  categories Category[]

  guideId Int
  guide   Guide @relation(fields: [guideId], references: [id_guide])
}
